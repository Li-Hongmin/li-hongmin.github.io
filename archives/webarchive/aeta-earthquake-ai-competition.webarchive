$(document).ready(function() {
	$('li', '.nav').hover(
		function() {
			$(this).toggleClass('on');
			$('.sub-menu', this).show();
		},
		function() {
			$(this).toggleClass('on');
			$('.sub-menu', this).slideUp();
		}
	);
});



