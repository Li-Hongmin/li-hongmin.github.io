/*
Theme Name: Two
Theme URI: http://web.pkusz.edu.cn/
Author: ITS
Author URI: http://its.pkusz.edu.cn/
Description: è“è‰²ä¸»é¢˜ï¼Œå®éªŒå®¤ä¸“ç”¨
Version: 1.0
License: GNU General Public License v2 or later
License URI: http://www.gnu.org/licenses/gpl-2.0.html
Tags: system,its
Text Domain: Two
*/
html,body{background:#FFF;padding:0;margin:0;font:normal 12px/20px 'å®‹ä½“','Microsoft Sans Serif';color:#222;}
a:link,a:visited,a:hover,a:active {text-decoration:none;}
img {border:none;margin:0;padding:0;}
ul,form{margin:0;padding:0;}
li{list-style:none;}
hr { margin:0; border:none; border-top:1px solid #eee; }
.clear {font-size:0;line-height:0px;width:100%;clear: both;}
.blank5 {height: 5px;width: 100%; clear: both;}
.blank10 {height: 10px; width: 100%;line-height:10px; font-size:10px; clear: both;}
.blank15 {height: 15px; width: 100%; line-height:15px; font-size:15px; clear: both;}
.blank20 {height: 20px; width: 100%; line-height:20px; font-size:20px; clear: both;}

/*
-------------------------
*	å¤´éƒ¨ @å…¨å±€
-------------------------
*/
.header {padding-top:20px;background:#076296;box-shadow: 0 3px 5px #ccc;}
.top {width:980px; margin:0 auto; padding-bottom:20px;}
.logo {width:250px; height:95px; float:left;}
.logo img{-margin-top:-23px;}
.title {width:700px; height:55px; padding-top:25px; float:right; color:#fff; font-family:'å¾®è½¯é›…é»‘','Microsoft Sans Serif';}
.title .cn{font-size:23px; height:35px; line-height:35px;}
.title .en{font-size:14px; color:#c8c8c8;  font-family:'Microsoft Sans Serif';}

/*å¯¼èˆª*/
.nav {
	width:100%; 
	height:40px; 
	line-height:40px; 
	/*background:url(images/nav.jpg) repeat-x; */
	clear:both;
    display:flex;
    justify-content: center;
    background:#004e7b;
}
.nav li { float:left; }
.nav li:hover { background:#1782c0; color:#FFF; }
.nav a { display:block; padding:0 20px; font-size:14px; color:#FFF; font-family:'Microsoft Sans Serif'; }
.nav a:hover{ background:#1782c0; color:#FFF; }
.nav .current-menu-item a { background:#1782c0; color:#FFF; }
.nav .sub-menu { display:none; position:absolute; z-index:13; background:#1782c0; border:1px solid #1782c0; border-top:none; }
.nav .sub-menu li { float:none; }
.nav .sub-menu a { display:block; height:30px; line-height:30px; }

/*ä¸»é¢˜banner*/
.main { width:980px; margin:0 auto; background:#FFF;}

.banner {width:690px; height:260px; position:relative; float:left; overflow:hidden;}
.bigpic {width:690px; height:260px; }
.bigpic img{width:690px; height:260px;}
.bigtit {width:650px; height:26px; line-height:26px; padding:0 20px; position:absolute; left:0; bottom:0; z-index:13; background:#000; opacity: 0.6;filter:alpha(opacity=60); overflow:hidden;}
.bigtit li{padding-left:20px;}
.bigtit a{color:#FFF; font-size:14px; font-weight:bold;}
.small {width:280px; height:258px; padding:1px 0 1px 10px; background:#eee; overflow:hidden; float:left;}
.small img {width:280px; height:85px; float:left; margin-bottom:1px; opacity: 0.6; filter: alpha(opacity=60); cursor:pointer;}
.small .on img{opacity: 1;filter: alpha(opacity=100);}

/*é¦–é¡µæ¨¡å—*/
.index {margin:20px 0; }
.mainbox {width:980px; margin:0 auto; background:#fff; overflow:hidden;}
.mainbox .box { width:296px; padding:10px 20px 10px 10px; float:left; overflow:hidden; }
.mainbox .box ul{ width:296px; overflow:hidden;}
.mainbox :first-child { padding-left:0; }
.mainbox :nth-child(3n).box { width:328px; padding-right:0; }
.mainbox :nth-child(3n) ul{ width:328px; overflow:hidden;}
.mainbox .nobg {background:none;}
.mainbox .box .tit{margin:0; margin-bottom:5px; padding:5px 0; font-size:14px; font-weight:normal; border-bottom:1px solid #076296;}
.mainbox .box .tit a{float:right;}
.mainbox .box .textwidget{ word-break: break-all; }
.mainbox .box li{height:27px; line-height:27px; border-bottom:1px solid #eee;white-space: nowrap;text-overflow: ellipsis;-o-text-overflow: ellipsis;overflow: hidden;}
.mainbox .box a{color:#444;}
.mainbox .box a:hover{color:#076296}

/*
-------------------------
*	ä¸»ä½“å’Œè¾¹æ 
-------------------------
*/
.common {width:648px; height:auto !important; height:400px; min-height:400px; padding:20px; border:1px solid #ddd; border-radius:4px; float:left;}
.common .title{width:100%; height:30px; line-height:30px; margin:0; font-size:18px; color:#333; clear:both;}
.sidebar{width:256px; padding:10px; border:1px solid #ddd; border-radius:4px; margin-left:10px; float:left;}
.band {margin-bottom:15px;}
.band .tit{padding-bottom:3px; margin-bottom:5px; border-bottom:1px solid #ccc; font-size:14px; color:#1782c0;}
.band li{height:22px; line-height:22px;}
.band a{color:#333;}
.band a:hover{color:#1782c0;}

/*
-------------------------
*	å•é¡µ page
-------------------------
*/
.article {height:auto !important; height:400px; min-height:400px; line-height:180%; font-size:14px; clear:both;}
.article img.aligncenter { display:block; margin:0 auto;}


/*
-------------------------
*	æ ç›®åˆ—è¡¨ category
-------------------------
*/
.lists h2{margin:0; margin-bottom:5px; padding:5px; border-bottom:1px dotted #ddd; font-size:14px; color:#1782c0;}
.lists h2 a{color:#1782c0}
.lists li{height:27px; line-height:27px; padding:0 10px; border-bottom:1px dashed #eee;}
.lists a{width:520px; display:block; font-size:14px; color:#333; white-space: nowrap;text-overflow: ellipsis;-o-text-overflow: ellipsis; overflow:hidden; float:left;}
.lists a:hover{color:#1782c0; text-decoration:underline;}
.lists span{float:right;}
.wp-pagenavi{display:block; margin:20px; text-align:right;}
.wp-pagenavi span {padding:4px 5px; border:1px solid #ccc;}
.wp-pagenavi .pages{margin-right:5px;}
.wp-pagenavi .current{ color:red; font-weight:bold; padding:4px 8px; margin-left:-1px;}
.wp-pagenavi a {padding:4px 8px; border:1px solid #ccc; margin-left:-1px; color:#076296;}


/*
-----------------------------
*	å†…å®¹é¡µ single.php
-----------------------------
*/
.post .title {margin:0; padding:5px 0; font-size:20px; font-weight:normal; text-align:center;}
.post .tips {border-bottom:1px dotted #eee; text-align:right; color:#bbb;}
.post .content {font-size:14px; line-height:180%; height:auto !important; height:400px; min-height:400px;}
.post img.aligncenter { display:block; margin:0 auto; }
.post .prev { padding:5px 0; border-top:1px dashed #ddd; }
.post .prev a{ color:#1782c0; }


/*
-----------------------------
*	404	é¡µé¢ 404.php
-----------------------------
*/
.tit404 {margin:0; padding:5px 0;}
.recent {margin:10px 0; padding:10px;}
.recent h2{margin:0; padding:5px 0; border-bottom:1px dotted #ccc;}
.recent li{height:27px; line-height:27px;}
.recent a{color:#333;}

/*
-------------------------
*	åº•éƒ¨ @å…¨å±€
-------------------------
*/
.footer {
	width:940px;
	margin:0 auto;
	margin-top:20px;
	padding:20px;
	color:#fff;
	font-family:verdana;
	border-radius:4px 4px 0 0;
	background:#076296;
	background: -webkit-linear-gradient(top, #076296, #056296);  
	background: -o-linear-gradient(top, #076296, #056296);
	background: -moz-linear-gradient(top, #076296, #056296);
	background: -webkit-gradient(linear, 0% 0%, 0% 100%, from(#076296), to(#056296));
	background: -ms-linear-gradient(top, #076296, #056296);
}
.footer p{margin:0; line-height:27px;}
.footer a{color:#fff;}
.float { position:fixed; left:50%; top:190px; margin-left:520px; width:200px; border:1px solid #ccc; padding:20px; color:#666; background:#FFF;}
.float .tit { line-height:30px;}
.float .float-tit { line-height:30px; background:#046196; color:#FFF; text-align:center; border-radius:5px; font-weight:bold;}
.float .textwidget { font-size:14px; line-height:28px; }
.float .mylink {display:block; line-height:30px; font-size:14px; background:#076296; border-radius:4px; color:#FFF !important; text-align:center; margin:10px 0;}
.float .mylink:hover{ background:#737373;}


/*æ’ä»¶æ ·å¼*/
.wp-video {margin:20px auto;}Xtext/cssOÄbplist00Ô
