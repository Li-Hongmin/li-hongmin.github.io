$(document).ready(function(){
	$('.bigpic').cycle({
		fx:     'fade', 
		speed:  1000, 
		pager:  '.small', 
		activePagerClass: 'on',
		pagerAnchorBuilder: function(idx, slide){
			return '.small li:eq(' + idx + ')';
		}
	});
	
	$('.bigtit').cycle({
		fx:     'fade', 
		speed:  1000, 
		pager:  '.small', 
		activePagerClass: 'on',
		pagerAnchorBuilder: function(idx, slide){
			return '.small li:eq(' + idx + ')';
		}
	});
});


