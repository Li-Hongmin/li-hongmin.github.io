{
  "name": "hongmin-profile-hub",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "predev": "npm run profile:generate",
    "dev": "npm run dev --workspace @hongmin/homepage",
    "prebuild": "npm run profile:check",
    "build": "npm run build --workspace @hongmin/homepage",
    "prebuild:sites": "npm run profile:check",
    "build:sites": "npm run build:sites --workspace @hongmin/homepage",
    "preview": "npm run preview --workspace @hongmin/homepage",
    "test": "npm run test --workspace @hongmin/homepage",
    "test:run": "node --test tools/profile/profile.test.mjs && npm run test:run --workspace @hongmin/homepage",
    "pretypecheck": "npm run profile:check",
    "typecheck": "npm run typecheck --workspace @hongmin/homepage",
    "profile:generate": "node tools/profile/generate.mjs",
    "profile:validate": "node tools/profile/validate.mjs",
    "profile:check": "node tools/profile/check-generated.mjs"
  }
}
